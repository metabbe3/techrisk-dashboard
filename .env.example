APP_NAME=TechriskDashboard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://techrisk.paas.dana.id

# --- Logging ---
# Daily rotation auto-deletes logs older than LOG_DAILY_DAYS, preventing the
# infinite single laravel.log that grew to ~3GB in the production disk-full
# outage. (Production: consider raising LOG_LEVEL from debug to warning/error.)
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14

# --- Database Configuration ---
# Use the service name 'db' or container name 'techrisk-db'
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=password

# --- Redis Configuration ---
# Use the service name 'redis' (service name, not container name)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Cache & Session ---
CACHE_STORE=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# For HTTPS sites behind proxy/load balancer, set domain with leading dot (e.g., .paas.dana.id)
SESSION_DOMAIN=.paas.dana.id
# Must be true for HTTPS sites (if using HTTP, change to false)
SESSION_SECURE_COOKIE=true

# --- Queue ---
QUEUE_CONNECTION=redis

# --- Broadcasting ---
BROADCAST_CONNECTION=log

# Production realtime (optional): VITE_* values are BAKED INTO the committed
# public/build at `npm run build` time — building with dev values ships
# wss://localhost:8081 to production (BUG-020). Echo now refuses to connect
# when the baked host doesn't match the serving origin, so a dev-built bundle
# in production is silent. To enable realtime, build with the public host and
# route wss://<host>/app/* at the ingress to the reverb container (host port 8081):
#   REVERB_APP_ID=local-key
#   REVERB_APP_KEY=local-key
#   REVERB_APP_SECRET=<secret>
#   REVERB_HOST=reverb
#   REVERB_PORT=8080
#   REVERB_SCHEME=http
#   VITE_REVERB_APP_KEY=local-key
#   VITE_REVERB_HOST=techrisk.paas.dana.id
#   VITE_REVERB_PORT=443
#   VITE_REVERB_SCHEME=https

# --- AI Text Enhancement ---
AI_API_BASE_URL=
AI_API_KEY=
AI_API_DEFAULT_MODEL=default
AI_API_TIMEOUT=30
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_INPUT_LENGTH=5000

AI_SEARCH_PROVIDER=gateway
AI_SEARCH_GEMINI_API_KEY=
AI_SEARCH_GEMINI_MODEL=gemini-2.5-flash
AI_SEARCH_GEMINI_BASE_URL=
AI_SEARCH_MAX_RESULTS=8
AI_SEARCH_TIMEOUT=15

# ---- Mail / Netcore email ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="techrisk-noreply@dana.id"
MAIL_FROM_NAME="${APP_NAME}"
# Set MAIL_MAILER=netcore to send email via Netcore Cloud (api_key header, v5/mail/send).
NETCORE_API_KEY=
NETCORE_BASE_URL=https://emailapi.netcorecloud.net
NETCORE_TIMEOUT=30