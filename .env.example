APP_NAME=TechriskDashboard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://techrisk.paas.dana.id

# --- Logging ---
# Daily rotation auto-deletes logs older than LOG_DAILY_DAYS, preventing the
# infinite single laravel.log that grew to ~3GB in the production disk-full
# outage. (Production: consider raising LOG_LEVEL from debug to warning/error.)
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14

# --- Database Configuration ---
# Use the service name 'db' or container name 'techrisk-db'
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=password

# --- Redis Configuration ---
# Use the service name 'redis' (service name, not container name)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Cache & Session ---
CACHE_STORE=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# For HTTPS sites behind proxy/load balancer, set domain with leading dot (e.g., .paas.dana.id)
SESSION_DOMAIN=.paas.dana.id
# Must be true for HTTPS sites (if using HTTP, change to false)
SESSION_SECURE_COOKIE=true

# --- Queue ---
QUEUE_CONNECTION=redis

# --- Broadcasting ---
BROADCAST_CONNECTION=log

# Local dev: REVERB_HOST_PORT (the docker-compose publish) must equal
# VITE_REVERB_PORT and must be a host port nothing else owns — a colliding
# local service on 127.0.0.1 silently eats the WS handshake and every page
# logs a 404 that looks like a Reverb bug (8081 collided here once).

# Production realtime (optional): VITE_* values are BAKED INTO the committed
# public/build at `npm run build` time — building with dev values ships
# wss://localhost:8081 to production (BUG-020). Echo now refuses to connect
# when the baked host doesn't match the serving origin, so a dev-built bundle
# in production is silent. To enable realtime, build with the public host and
# route wss://<host>/app/* at the ingress to the reverb container (host port 8081):
#   REVERB_APP_ID=local-key
#   REVERB_APP_KEY=local-key
#   REVERB_APP_SECRET=<secret>
#   REVERB_HOST=reverb
#   REVERB_PORT=8080
#   REVERB_SCHEME=http
#   VITE_REVERB_APP_KEY=local-key
#   VITE_REVERB_HOST=techrisk.paas.dana.id
#   VITE_REVERB_PORT=443
#   VITE_REVERB_SCHEME=https

# --- AI Text Enhancement ---
AI_API_BASE_URL=
AI_API_KEY=
AI_API_DEFAULT_MODEL=default
AI_API_TIMEOUT=30
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_INPUT_LENGTH=5000

AI_SEARCH_PROVIDER=gateway
AI_SEARCH_GEMINI_API_KEY=
AI_SEARCH_GEMINI_MODEL=gemini-2.5-flash
AI_SEARCH_GEMINI_BASE_URL=
AI_SEARCH_MAX_RESULTS=8
AI_SEARCH_TIMEOUT=15

# ---- Mail / Netcore email ----
MAIL_MAILER=log
MAIL_FROM_ADDRESS="techrisk-noreply@dana.id"
MAIL_FROM_NAME="${APP_NAME}"
# Set MAIL_MAILER=netcore to send email via Netcore Cloud (api_key header, v5/mail/send).
NETCORE_API_KEY=
NETCORE_BASE_URL=https://emailapi.netcorecloud.net
NETCORE_TIMEOUT=30

# ---- Notion MCP ----
# Hosted MCP server URL (OAuth 2.1 connects from the Notion Settings admin page —
# no token in .env). If the app domain is NOT publicly reachable (e.g. VPN-only),
# register a client once (POST https://mcp.notion.com/register with the app's
# callback as redirect_uris) and fill these — otherwise leave empty and the
# automatic per-connect registration flow applies.
NOTION_MCP_URL=https://mcp.notion.com/mcp
NOTION_MCP_TIMEOUT=60
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=
# Microsoft (Entra ID) SSO — App registrations → Overview (client/tenant ID),
# Certificates & secrets → the secret's Value (not its Secret ID).
# Redirect URI must match the Azure app registration exactly; local dev uses
# http://localhost:8000/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=https://techrisk.paas.dana.id/auth/microsoft/callback

# DingTalk stream agent (dingtalk-agent sidecar) — DingTalk Open Platform app
# credentials; robot must use "Stream mode". ALLOWLIST = comma staffIds to
# narrow access; empty = everyone in the app's visibility range can chat.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ALLOWLIST=
DINGTALK_MODEL=
# Web research (web_search/web_fetch tools, SSRF-guarded). 1 = on, 0/off = kill switch.
#DINGTALK_WEB_TOOLS=1
# Per-user preference learning from conversations (data/profiles.json). 0/off = off.
#AGENT_AUTO_LEARN=1
# Agent loop overrides — defaults: max 60 iterations, reply cap 8000 chars.
#AGENT_MAX_ITER=60
#AGENT_MAX_REPLY_CHARS=8000
# Dashboard API token for the agent (Filament → API Tokens; abilities:
# incidents, incidents-by-no, incidents-markdown)
DASHBOARD_API_TOKEN=
